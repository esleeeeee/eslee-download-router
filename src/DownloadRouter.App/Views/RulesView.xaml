<UserControl
    x:Class="DownloadRouter.App.Views.RulesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:DownloadRouter.App.Controls"
    xmlns:vm="using:DownloadRouter.App.ViewModels">
  <UserControl.KeyboardAccelerators>
    <KeyboardAccelerator Key="F" Invoked="FocusSearch_Invoked" Modifiers="Control" />
    <KeyboardAccelerator Key="N" Invoked="NewRule_Invoked" Modifiers="Control" />
  </UserControl.KeyboardAccelerators>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="340" MinWidth="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- List pane -->
    <Border Style="{StaticResource PaneStyle}">
      <Grid
          x:Name="ListPane"
          Padding="16,24,16,12"
          AllowDrop="True"
          DragLeave="ListPane_DragLeave"
          DragOver="ListPane_DragOver"
          Drop="ListPane_Drop"
          RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{c:L Ko='사이트 규칙', En='Site rules'}" />
          <Button
              x:Name="NewRuleButton"
              Grid.Column="1"
              AutomationProperties.Name="{c:L Ko='새 규칙 만들기', En='New rule'}"
              Click="NewRule_Click"
              Style="{StaticResource AccentButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon FontSize="14" Glyph="&#xE710;" />
              <TextBlock Text="{c:L Ko='새 규칙', En='New'}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" AutomationProperties.Name="{c:L Ko='규칙 백업 메뉴', En='Rule backup menu'}" ToolTipService.ToolTip="{c:L Ko='내보내기·가져오기', En='Export / import'}">
            <FontIcon FontSize="14" Glyph="&#xE712;" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuFlyoutItem Click="ExportRules_Click" Text="{c:L Ko='규칙 내보내기…', En='Export rules…'}">
                  <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xEDE1;" />
                  </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Click="ImportRules_Click" Text="{c:L Ko='규칙 가져오기…', En='Import rules…'}">
                  <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8B5;" />
                  </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            AutomationProperties.Name="{c:L Ko='규칙 검색', En='Search rules'}"
            PlaceholderText="{c:L Ko='이름이나 사이트로 검색 (Ctrl+F)', En='Search by name or site (Ctrl+F)'}"
            TextChanged="SearchBox_TextChanged" />

        <StackPanel x:Name="FilterChips" Grid.Row="2" Orientation="Horizontal">
          <RadioButton x:Name="AllChip" Checked="Filter_Checked" GroupName="RuleFilter" IsChecked="True" Style="{StaticResource ChipRadioButtonStyle}" Tag="all" />
          <RadioButton x:Name="EnabledChip" Checked="Filter_Checked" GroupName="RuleFilter" Style="{StaticResource ChipRadioButtonStyle}" Tag="enabled" />
          <RadioButton x:Name="DisabledChip" Checked="Filter_Checked" GroupName="RuleFilter" Style="{StaticResource ChipRadioButtonStyle}" Tag="disabled" />
          <RadioButton x:Name="AttentionChip" Checked="Filter_Checked" GroupName="RuleFilter" Style="{StaticResource ChipRadioButtonStyle}" Tag="attention" />
        </StackPanel>

        <Grid Grid.Row="3">
          <ListView
              x:Name="RuleList"
              ItemContainerStyle="{StaticResource AppListViewItemStyle}"
              KeyDown="RuleList_KeyDown"
              SelectionChanged="RuleList_SelectionChanged"
              SelectionMode="Single">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:RuleRowItem">
                <Grid Background="Transparent" ColumnSpacing="12" ContextRequested="RuleRow_ContextRequested" Tag="{x:Bind}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <c:IconPlate Glyph="{x:Bind Glyph, Mode=OneWay}" Kind="{x:Bind PlateKind, Mode=OneWay}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}" Text="{x:Bind Summary, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  </StackPanel>
                  <TextBlock
                      Grid.Column="2"
                      VerticalAlignment="Top"
                      Style="{StaticResource CaptionSecondaryTextStyle}"
                      Text="{x:Bind StatusText, Mode=OneWay}"
                      TextWrapping="NoWrap" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel x:Name="ListEmpty" Padding="12,24" Spacing="8" Visibility="Collapsed">
            <FontIcon FontSize="28" Foreground="{ThemeResource TextTertiaryBrush}" Glyph="&#xE71C;" />
            <TextBlock x:Name="ListEmptyText" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" />
          </StackPanel>
          <Border
              x:Name="DropOverlay"
              Background="{ThemeResource DropOverlayBrush}"
              BorderBrush="{ThemeResource AccentBrush}"
              BorderThickness="2"
              CornerRadius="8"
              IsHitTestVisible="False"
              Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <FontIcon FontSize="28" Foreground="{ThemeResource AccentTextBrush}" Glyph="&#xE8F4;" />
              <TextBlock
                  MaxWidth="240"
                  Foreground="{ThemeResource AccentTextBrush}"
                  Style="{StaticResource BodyStrongTextBlockStyle}"
                  Text="{c:L Ko='놓으면 이 폴더로 저장하는 새 규칙을 만듭니다', En='Drop to create a rule that saves into this folder'}"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock
            x:Name="ListFooter"
            Grid.Row="4"
            Style="{StaticResource CaptionSecondaryTextStyle}"
            Text="{c:L Ko='탐색기에서 폴더를 끌어다 놓으면 그 폴더로 새 규칙을 시작합니다.', En='Drag a folder from File Explorer here to start a rule for it.'}" />
      </Grid>
    </Border>

    <!-- Editor pane -->
    <Grid Grid.Column="1">
      <StackPanel x:Name="EditorEmpty" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <c:IconPlate HorizontalAlignment="Center" Glyph="&#xE71C;" Kind="Accent" Size="56" />
        <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{c:L Ko='규칙을 선택하거나 새로 만드세요', En='Select a rule or create one'}" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" Text="{c:L Ko='규칙은 어떤 사이트에서 받은 파일을 어느 폴더로 보낼지 정합니다. 규칙에 맞지 않는 다운로드는 브라우저가 평소처럼 저장합니다.', En='A rule decides which folder receives files downloaded from a site. Downloads that match no rule are saved by the browser as usual.'}" />
        <Button HorizontalAlignment="Center" Click="NewRule_Click" Style="{StaticResource AccentButtonStyle}" Content="{c:L Ko='새 규칙 만들기', En='Create a rule'}" />
      </StackPanel>

      <Grid x:Name="EditorPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="EditorScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="820" Padding="32,24,32,24" Spacing="12">
            <!-- Header -->
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <c:IconPlate x:Name="HeaderPlate" Glyph="&#xE71C;" Kind="Accent" Size="56" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="HeaderTitle" Style="{StaticResource PageTitleTextStyle}" FontSize="24" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <ToggleSwitch
                    x:Name="EnabledSwitch"
                    MinWidth="0"
                    AutomationProperties.Name="{c:L Ko='이 규칙 사용', En='Use this rule'}"
                    OffContent="{c:L Ko='꺼짐', En='Off'}"
                    OnContent="{c:L Ko='사용', En='On'}"
                    Toggled="EnabledSwitch_Toggled" />
                <Button x:Name="RuleMoreButton" AutomationProperties.Name="{c:L Ko='규칙 메뉴', En='Rule menu'}" Background="Transparent" BorderThickness="0">
                  <FontIcon FontSize="16" Glyph="&#xE712;" />
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuFlyoutItem Click="OpenRoot_Click" Text="{c:L Ko='기준 폴더 열기', En='Open base folder'}">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xE838;" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem Click="ShowRuleDownloads_Click" Text="{c:L Ko='이 규칙의 다운로드 보기', En='Show downloads for this rule'}">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xE896;" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutSeparator />
                      <MenuFlyoutItem Click="DeleteRule_Click" Foreground="{ThemeResource CriticalForegroundBrush}" Text="{c:L Ko='규칙 삭제', En='Delete rule'}">
                        <MenuFlyoutItem.Icon>
                          <FontIcon Glyph="&#xE74D;" />
                        </MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </Grid>

            <InfoBar x:Name="EditorRootWarning" IsClosable="False" Severity="Warning" />

            <!-- 1. Basic information -->
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{c:L Ko='1. 규칙 기본 정보', En='1. Basic information'}" />
            <Border Style="{StaticResource CardStyle}">
              <TextBox
                  x:Name="NameBox"
                  Header="{c:L Ko='규칙 이름', En='Rule name'}"
                  MaxLength="100"
                  PlaceholderText="{c:L Ko='예: 회사 자료실 다운로드', En='e.g. Company file library'}"
                  TextChanged="Editor_Changed" />
            </Border>

            <!-- 2. Which downloads -->
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{c:L Ko='2. 어떤 다운로드에 적용할까요', En='2. Which downloads does it apply to'}" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel Spacing="12">
                <TextBox
                    x:Name="MatchValueBox"
                    Header="{c:L Ko='사이트 주소 또는 주소에 들어 있는 문구', En='Site address or text in the address'}"
                    PlaceholderText="naver.com"
                    TextChanged="Editor_Changed" />
                <ComboBox x:Name="MatchTypeBox" HorizontalAlignment="Stretch" Header="{c:L Ko='적용 범위', En='Match'}" SelectionChanged="Editor_Changed" />
                <TextBlock x:Name="MatchTypeHelp" Style="{StaticResource CaptionSecondaryTextStyle}" />
                <ComboBox x:Name="MatchTargetBox" HorizontalAlignment="Stretch" Header="{c:L Ko='확인할 주소', En='Address to check'}" SelectionChanged="Editor_Changed" />
                <TextBlock x:Name="MatchTargetHelp" Style="{StaticResource CaptionSecondaryTextStyle}" />
              </StackPanel>
            </Border>

            <!-- 3. File types -->
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{c:L Ko='3. 어떤 파일에 적용할까요', En='3. Which files does it apply to'}" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel Spacing="12">
                <ComboBox x:Name="FileTypeModeBox" HorizontalAlignment="Stretch" Header="{c:L Ko='파일 종류', En='File types'}" SelectionChanged="Editor_Changed" />
                <TextBlock x:Name="FileTypeHelp" Style="{StaticResource CaptionSecondaryTextStyle}" />
                <StackPanel x:Name="ExtensionsPanel" Spacing="8">
                  <TextBox
                      x:Name="ExtensionsBox"
                      Header="{c:L Ko='확장자 (쉼표나 띄어쓰기로 구분)', En='Extensions (separate with commas or spaces)'}"
                      PlaceholderText="pdf, hwp, docx"
                      TextChanged="Editor_Changed" />
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryTextStyle}" Text="{c:L Ko='빠른 추가:', En='Quick add:'}" />
                    <HyperlinkButton Click="AddPreset_Click" Content="{c:L Ko='문서', En='Documents'}" Tag="pdf hwp hwpx doc docx xls xlsx ppt pptx txt" />
                    <HyperlinkButton Click="AddPreset_Click" Content="{c:L Ko='이미지', En='Images'}" Tag="jpg jpeg png gif webp bmp heic" />
                    <HyperlinkButton Click="AddPreset_Click" Content="{c:L Ko='압축', En='Archives'}" Tag="zip 7z rar tar.gz" />
                    <HyperlinkButton Click="AddPreset_Click" Content="{c:L Ko='동영상', En='Videos'}" Tag="mp4 mkv mov avi webm" />
                  </StackPanel>
                  <TextBlock x:Name="ExtensionsError" Foreground="{ThemeResource CriticalForegroundBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 4. Destination -->
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{c:L Ko='4. 어디로 보낼까요', En='4. Where should files go'}" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel Spacing="12">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="StorageRootBox" Header="{c:L Ko='기준 폴더', En='Base folder'}" TextChanged="StorageRootBox_TextChanged" />
                  <Button Grid.Column="1" VerticalAlignment="Bottom" Click="BrowseRoot_Click" Content="{c:L Ko='찾아보기…', En='Browse…'}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Grid Width="16" VerticalAlignment="Center">
                    <ProgressRing x:Name="RootChecking" Width="14" Height="14" IsActive="False" />
                    <FontIcon x:Name="RootOkIcon" FontSize="14" Foreground="{ThemeResource SuccessForegroundBrush}" Glyph="&#xE73E;" Visibility="Collapsed" />
                    <FontIcon x:Name="RootBadIcon" FontSize="14" Foreground="{ThemeResource CautionForegroundBrush}" Glyph="&#xE7BA;" Visibility="Collapsed" />
                  </Grid>
                  <TextBlock x:Name="RootStatusText" Style="{StaticResource CaptionSecondaryTextStyle}" />
                </StackPanel>
                <Border Style="{StaticResource DividerStyle}" />
                <ComboBox x:Name="StorageModeBox" HorizontalAlignment="Stretch" Header="{c:L Ko='저장 방식', En='How to save'}" SelectionChanged="Editor_Changed" />
                <TextBlock x:Name="StorageModeHelp" Style="{StaticResource CaptionSecondaryTextStyle}" />
              </StackPanel>
            </Border>

            <!-- 5. Summary -->
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{c:L Ko='5. 규칙 요약', En='5. Summary'}" />
            <Border Padding="16,12" Background="{ThemeResource AccentSubtleBrush}" CornerRadius="8">
              <TextBlock x:Name="SummaryText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Separated save area -->
        <Border Grid.Row="1" Padding="32,12" Background="{ThemeResource PaneBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="0,1,0,0">
          <Grid MaxWidth="756" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DirtyText" VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryTextStyle}" />
            <Button x:Name="RevertButton" Grid.Column="1" Click="Revert_Click" />
            <Button x:Name="SaveButton" Grid.Column="2" MinWidth="120" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
