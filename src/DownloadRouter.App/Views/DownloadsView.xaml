<UserControl
    x:Class="DownloadRouter.App.Views.DownloadsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:DownloadRouter.App.Controls"
    xmlns:vm="using:DownloadRouter.App.ViewModels">
  <UserControl.KeyboardAccelerators>
    <KeyboardAccelerator Key="F" Invoked="FocusSearch_Invoked" Modifiers="Control" />
  </UserControl.KeyboardAccelerators>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="380" MinWidth="300" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- List pane -->
    <Border Style="{StaticResource PaneStyle}">
      <Grid Padding="16,24,16,12" RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{c:L Ko='다운로드', En='Downloads'}" />
          <Button Grid.Column="1" AutomationProperties.Name="{c:L Ko='다운로드 기록 메뉴', En='Download history menu'}" Background="Transparent" BorderThickness="0">
            <FontIcon FontSize="16" Glyph="&#xE712;" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuFlyoutItem Click="ClearCancelled_Click" Text="{c:L Ko='취소된 기록 정리', En='Clear cancelled entries'}">
                  <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                  </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Click="OpenRetentionSettings_Click" Text="{c:L Ko='오래된 기록 자동 정리 설정', En='Automatic cleanup settings'}">
                  <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                  </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            AutomationProperties.Name="{c:L Ko='다운로드 검색', En='Search downloads'}"
            PlaceholderText="{c:L Ko='파일 이름, 사이트, 규칙으로 검색 (Ctrl+F)', En='Search by file, site or rule (Ctrl+F)'}"
            TextChanged="SearchBox_TextChanged" />

        <c:WrapPanel Grid.Row="2">
          <RadioButton x:Name="AllChip" Checked="Filter_Checked" GroupName="DownloadFilter" IsChecked="True" Style="{StaticResource ChipRadioButtonStyle}" Tag="All" />
          <RadioButton x:Name="PendingChip" Checked="Filter_Checked" GroupName="DownloadFilter" Style="{StaticResource ChipRadioButtonStyle}" Tag="Pending" />
          <RadioButton x:Name="InProgressChip" Checked="Filter_Checked" GroupName="DownloadFilter" Style="{StaticResource ChipRadioButtonStyle}" Tag="InProgress" />
          <RadioButton x:Name="CompletedChip" Checked="Filter_Checked" GroupName="DownloadFilter" Style="{StaticResource ChipRadioButtonStyle}" Tag="Completed" />
          <RadioButton x:Name="FailedChip" Checked="Filter_Checked" GroupName="DownloadFilter" Style="{StaticResource ChipRadioButtonStyle}" Tag="Failed" />
          <RadioButton x:Name="SkippedChip" Checked="Filter_Checked" GroupName="DownloadFilter" Style="{StaticResource ChipRadioButtonStyle}" Tag="Skipped" />
          <RadioButton x:Name="CancelledChip" Checked="Filter_Checked" GroupName="DownloadFilter" Style="{StaticResource ChipRadioButtonStyle}" Tag="CancelledOrInterrupted" />
        </c:WrapPanel>

        <Grid Grid.Row="3">
          <ListView
              x:Name="JobList"
              ItemContainerStyle="{StaticResource AppListViewItemStyle}"
              KeyDown="JobList_KeyDown"
              SelectionChanged="JobList_SelectionChanged"
              SelectionMode="Extended">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:JobRowItem">
                <Grid Background="Transparent" ColumnSpacing="12" ContextRequested="JobRow_ContextRequested" Opacity="{x:Bind RowOpacity, Mode=OneWay}" Tag="{x:Bind}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <c:IconPlate Glyph="{x:Bind Glyph, Mode=OneWay}" Kind="{x:Bind Kind, Mode=OneWay}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind FileName, Mode=OneWay}"
                        TextDecorations="{x:Bind FileNameDecorations, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}" Text="{x:Bind Subtitle, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                      <c:StatusBadge Grid.Column="1" Kind="{x:Bind Kind, Mode=OneWay}" Text="{x:Bind StatusText, Mode=OneWay}" />
                    </Grid>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <StackPanel x:Name="ListEmpty" Padding="12,24" Spacing="8" Visibility="Collapsed">
            <FontIcon FontSize="28" Foreground="{ThemeResource TextTertiaryBrush}" Glyph="&#xE896;" />
            <TextBlock x:Name="ListEmptyText" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" />
          </StackPanel>
        </Grid>

        <TextBlock
            x:Name="ListFooter"
            Grid.Row="4"
            Style="{StaticResource CaptionSecondaryTextStyle}"
            Text="{c:L Ko='Ctrl이나 Shift를 누른 채 누르면 여러 개를 함께 처리할 수 있습니다. 기록을 지워도 실제 파일은 지워지지 않습니다.', En='Hold Ctrl or Shift to select several. Deleting history never deletes the actual files.'}" />
      </Grid>
    </Border>

    <!-- Detail pane -->
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Grid MaxWidth="820" Padding="32,24,32,24">
        <!-- Nothing selected -->
        <StackPanel x:Name="NoSelectionPanel" Spacing="12">
          <StackPanel x:Name="NoSelectionHint" Margin="0,80,0,0" HorizontalAlignment="Center" Spacing="12">
            <c:IconPlate HorizontalAlignment="Center" Glyph="&#xE896;" Kind="Accent" Size="56" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="{c:L Ko='다운로드를 선택하세요', En='Select a download'}" />
            <TextBlock MaxWidth="420" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" Text="{c:L Ko='사이트 규칙에 맞은 다운로드만 여기에 기록됩니다. 저장 위치를 고르거나, 파일을 열거나, 실패한 이동을 다시 시도할 수 있습니다.', En='Only downloads that matched a site rule are listed. Choose folders, open files, or retry failed moves here.'}" />
          </StackPanel>

          <!-- Pending workspace: per-rule bulk actions -->
          <StackPanel x:Name="PendingWorkspace" Spacing="12" Visibility="Collapsed">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" FontSize="24" Text="{c:L Ko='저장 위치 선택 대기', En='Waiting for a folder'}" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{c:L Ko='파일을 하나 고르면 그 파일의 저장 위치를 정할 수 있습니다. 같은 규칙의 파일은 아래에서 한 번에 처리할 수 있습니다.', En='Select a file to choose its folder. Files from the same rule can be handled together below.'}" />
            <InfoBar x:Name="PreviousSessionBar" IsClosable="False" Severity="Informational" Title="{c:L Ko='이전에 남겨 둔 대기 파일', En='Files left waiting earlier'}" />
            <ItemsControl x:Name="PendingGroups">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PendingRuleGroup">
                  <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16" RowSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <c:IconPlate Glyph="&#xE8B7;" Kind="Caution" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{x:Bind Title}" />
                        <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}" Text="{x:Bind RootText}" />
                      </StackPanel>
                      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Click="ApplyGroup_Click" Content="{c:L Ko='이 규칙의 대기 파일에 같은 폴더 적용', En='Apply one folder to all'}" Style="{StaticResource AccentButtonStyle}" Tag="{x:Bind}" />
                        <Button Click="SkipGroup_Click" Content="{c:L Ko='모두 옮기지 않기', En='Do not move any'}" Style="{StaticResource DangerTextButtonStyle}" Tag="{x:Bind}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="OrphanedText" Style="{StaticResource CaptionSecondaryTextStyle}" Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>

        <!-- One download -->
        <StackPanel x:Name="DetailPanel" Spacing="12" Visibility="Collapsed">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:IconPlate x:Name="DetailPlate" Size="56" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <TextBlock x:Name="DetailTitle" Style="{StaticResource PageTitleTextStyle}" FontSize="22" IsTextSelectionEnabled="True" />
              <c:StatusBadge x:Name="DetailBadge" />
            </StackPanel>
          </Grid>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="12">
              <TextBlock x:Name="ActionTitle" Style="{StaticResource CardTitleTextStyle}" />
              <TextBlock x:Name="ActionDescription" Style="{StaticResource SecondaryTextStyle}" />
              <c:WrapPanel x:Name="ActionButtons" />
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{c:L Ko='세부 정보', En='Details'}" />
          <Border Style="{StaticResource FlatCardStyle}">
            <StackPanel x:Name="DetailRows" />
          </Border>
        </StackPanel>

        <!-- Several downloads -->
        <StackPanel x:Name="MultiPanel" Spacing="12" Visibility="Collapsed">
          <TextBlock x:Name="MultiTitle" Style="{StaticResource PageTitleTextStyle}" FontSize="24" />
          <Border Style="{StaticResource CardStyle}">
            <StackPanel Spacing="12">
              <TextBlock Style="{StaticResource CardTitleTextStyle}" Text="{c:L Ko='선택한 파일 함께 처리', En='Handle the selected files together'}" />
              <TextBlock x:Name="MultiDescription" Style="{StaticResource SecondaryTextStyle}" />
              <c:WrapPanel>
                <Button x:Name="ApplySelectedButton" Margin="0,0,8,8" Click="ApplySelected_Click" Content="{c:L Ko='선택 항목 저장 위치 지정', En='Choose a folder for selected'}" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="SkipSelectedButton" Margin="0,0,8,8" Click="SkipSelected_Click" Content="{c:L Ko='선택 항목 옮기지 않기', En='Do not move selected'}" />
                <Button x:Name="DeleteSelectedButton" Margin="0,0,8,8" Click="DeleteSelected_Click" Content="{c:L Ko='선택 항목 기록 삭제', En='Delete selected from history'}" Style="{StaticResource DangerTextButtonStyle}" />
                <Button Margin="0,0,8,8" Click="ClearSelection_Click" Content="{c:L Ko='선택 해제', En='Clear selection'}" />
              </c:WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
