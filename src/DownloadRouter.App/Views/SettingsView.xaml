<UserControl
    x:Class="DownloadRouter.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:DownloadRouter.App.Controls">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="1000" Padding="{StaticResource PagePadding}" HorizontalAlignment="Stretch" Spacing="0">
      <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{c:L Ko='설정', En='Settings'}" />
      <TextBlock Margin="0,4,0,0" Style="{StaticResource PageSubtitleTextStyle}" Text="{c:L Ko='바꾼 내용은 바로 저장되고 적용됩니다.', En='Changes are saved and applied right away.'}" />

      <InfoBar
          x:Name="TestInstanceBar"
          Margin="0,16,0,0"
          IsClosable="False"
          Severity="Informational"
          Title="{c:L Ko='테스트 데이터 폴더로 실행 중', En='Running on a test data folder'}" />

      <!-- Appearance -->
      <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{c:L Ko='화면', En='Appearance'}" />
      <Border Style="{StaticResource FlatCardStyle}">
        <StackPanel>
          <c:SettingsCard
              BorderThickness="0"
              Description="{c:L Ko='밝게, 어둡게, 또는 Windows 설정과 같게 표시합니다.', En='Light, dark, or the same as Windows.'}"
              Glyph="&#xE790;"
              Header="{c:L Ko='테마', En='Theme'}">
            <ComboBox x:Name="ThemeBox" MinWidth="220" SelectionChanged="ThemeBox_SelectionChanged" />
          </c:SettingsCard>
          <c:SettingsCard
              Description="{c:L Ko='앱을 다시 시작하면 적용됩니다.', En='Applies after the app restarts.'}"
              Glyph="&#xF2B7;"
              Header="{c:L Ko='언어', En='Language'}">
            <ComboBox x:Name="LanguageBox" MinWidth="220" SelectionChanged="LanguageBox_SelectionChanged" />
          </c:SettingsCard>
        </StackPanel>
      </Border>
      <InfoBar
          x:Name="RestartBar"
          Margin="0,8,0,0"
          IsClosable="False"
          Severity="Informational"
          Title="{c:L Ko='다시 시작하면 새 언어로 표시됩니다', En='Restart to use the new language'}">
        <InfoBar.ActionButton>
          <Button Click="Restart_Click" Content="{c:L Ko='지금 다시 시작', En='Restart now'}" />
        </InfoBar.ActionButton>
      </InfoBar>

      <!-- Behavior -->
      <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{c:L Ko='동작', En='Behavior'}" />
      <Border Style="{StaticResource FlatCardStyle}">
        <StackPanel>
          <c:SettingsCard BorderThickness="0" Glyph="&#xE8BB;" Header="{c:L Ko='메인 창을 닫을 때', En='When the main window is closed'}">
            <ComboBox x:Name="CloseBehaviorBox" MinWidth="260" SelectionChanged="CloseBehaviorBox_SelectionChanged" />
          </c:SettingsCard>
          <c:SettingsCard
              x:Name="AutoStartCard"
              Description="{c:L Ko='창 없이 트레이로 조용히 시작해 다운로드를 분류합니다.', En='Starts quietly in the tray and keeps sorting downloads.'}"
              Glyph="&#xE7E8;"
              Header="{c:L Ko='Windows 로그인 시 자동 실행', En='Start when I sign in to Windows'}">
            <ToggleSwitch x:Name="AutoStartSwitch" MinWidth="0" Toggled="AutoStartSwitch_Toggled" />
          </c:SettingsCard>
          <c:SettingsCard
              Description="{c:L Ko='규칙에 따라 파일을 옮기면 Windows 알림으로 어느 폴더로 옮겼는지 알려 줍니다. 앱이 실행 중일 때만 표시됩니다.', En='Shows a Windows notification with the folder each time a file is moved. Only while the app is running.'}"
              Glyph="&#xEA8F;"
              Header="{c:L Ko='파일을 옮기면 알림 표시', En='Notify when a file is moved'}">
            <ToggleSwitch x:Name="NotifySwitch" MinWidth="0" Toggled="NotifySwitch_Toggled" />
          </c:SettingsCard>
        </StackPanel>
      </Border>

      <!-- History -->
      <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{c:L Ko='다운로드 기록', En='Download history'}" />
      <Border Style="{StaticResource FlatCardStyle}">
        <c:SettingsCard
            x:Name="RetentionCard"
            BorderThickness="0"
            Description="{c:L Ko='끝난 기록(옮김, 옮기지 않음, 취소, 중단)을 정한 기간이 지나면 지웁니다. 처리 대기와 실패 기록, 실제 파일은 지우지 않습니다.', En='Removes finished entries (moved, not moved, cancelled, stopped) after the chosen time. Waiting and failed entries and the files themselves are kept.'}"
            Glyph="&#xE81C;"
            Header="{c:L Ko='오래된 기록 자동 정리', En='Clean up old history automatically'}">
          <ComboBox x:Name="RetentionBox" MinWidth="220" SelectionChanged="RetentionBox_SelectionChanged" />
        </c:SettingsCard>
      </Border>
      <TextBlock x:Name="RetentionResult" Margin="2,6,0,0" Style="{StaticResource CaptionSecondaryTextStyle}" Visibility="Collapsed" />

      <!-- Troubleshooting -->
      <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{c:L Ko='문제 해결', En='Troubleshooting'}" />
      <Border Style="{StaticResource FlatCardStyle}">
        <StackPanel>
          <c:SettingsCard
              BorderThickness="0"
              Description="{c:L Ko='다운로드를 분류하는 백그라운드 서비스(Agent)가 응답하는지 확인합니다.', En='Checks that the background service (agent) that sorts downloads responds.'}"
              Glyph="&#xE703;"
              Header="{c:L Ko='Agent 연결 확인', En='Check the agent connection'}">
            <Button Click="Ping_Click" Content="{c:L Ko='확인', En='Check'}" />
          </c:SettingsCard>
          <c:SettingsCard
              x:Name="DataFolderCard"
              Glyph="&#xE8B7;"
              Header="{c:L Ko='데이터 폴더', En='Data folder'}">
            <Button Click="OpenDataFolder_Click" Content="{c:L Ko='열기', En='Open'}" />
          </c:SettingsCard>
          <c:SettingsCard x:Name="ScaleCard" Glyph="&#xE7F4;" Header="{c:L Ko='화면 배율', En='Display scale'}" />
          <Expander
              Padding="16,12"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              BorderThickness="0,1,0,0"
              CornerRadius="0"
              Expanding="DiagnosticsExpander_Expanding">
            <Expander.Header>
              <StackPanel Padding="0,8" Spacing="1">
                <TextBlock Text="{c:L Ko='진단 정보', En='Diagnostic details'}" />
                <TextBlock Style="{StaticResource CaptionSecondaryTextStyle}" Text="{c:L Ko='다운로드 주소와 파일 이름은 표시하지 않지만, 데이터 폴더 경로에는 Windows 계정 이름이 들어 있습니다. 캡처해 공유하기 전에 확인하세요.', En='Download addresses and file names are not shown, but the data folder path contains your Windows account name. Check before sharing a screenshot.'}" />
              </StackPanel>
            </Expander.Header>
            <TextBlock x:Name="DiagnosticsText" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
          </Expander>
        </StackPanel>
      </Border>

      <!-- About -->
      <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="{c:L Ko='정보', En='About'}" />
      <Border Style="{StaticResource FlatCardStyle}">
        <StackPanel>
          <c:SettingsCard x:Name="VersionCard" BorderThickness="0" Glyph="&#xE946;" Header="eslee Download Router" />
          <c:SettingsCard x:Name="UpdateCard" Glyph="&#xE895;" Header="{c:L Ko='업데이트', En='Updates'}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="CheckUpdateButton" Click="CheckUpdate_Click" Content="{c:L Ko='지금 확인', En='Check now'}" />
              <Button Click="OpenRelease_Click" Content="{c:L Ko='Release 페이지 열기', En='Open release page'}" />
            </StackPanel>
          </c:SettingsCard>
          <c:SettingsCard
              Description="{c:L Ko='텔레메트리, 광고, 계정 가입이 없습니다. 네트워크 요청은 업데이트 확인 하나뿐이며 GitHub의 공개 배포 정보만 읽고 개인 정보를 보내지 않습니다.', En='No telemetry, ads or accounts. The only network request is the update check, which reads public GitHub release information and sends no personal data.'}"
              Glyph="&#xE72E;"
              Header="{c:L Ko='개인정보', En='Privacy'}" />
          <c:SettingsCard x:Name="SupportCard" Glyph="&#xE774;" Header="{c:L Ko='지원 브라우저', En='Supported browsers'}" />
          <c:SettingsCard Glyph="&#xE943;" Header="{c:L Ko='소스 코드와 문제 신고', En='Source code and issues'}">
            <Button Click="OpenGitHub_Click" Content="GitHub" />
          </c:SettingsCard>
        </StackPanel>
      </Border>
      <Border Height="24" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
