<Window
    x:Class="DownloadRouter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:DownloadRouter.App.Controls">
  <Grid x:Name="RootGrid" Background="{ThemeResource WindowBackgroundBrush}" UseLayoutRounding="True">
    <NavigationView
        x:Name="Navigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        IsTitleBarAutoPaddingEnabled="False"
        OpenPaneLength="248"
        CompactModeThresholdWidth="640"
        ExpandedModeThresholdWidth="1000"
        PaneDisplayMode="Auto"
        SelectionChanged="Navigation_SelectionChanged">
      <NavigationView.PaneHeader>
        <TextBlock
            Margin="4,0,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            FontSize="16"
            Text="eslee Download Router"
            TextTrimming="CharacterEllipsis" />
      </NavigationView.PaneHeader>
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="HomeNavigationItem" Content="{c:L Ko='홈', En='Home'}" Tag="dashboard">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE80F;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem x:Name="RulesNavigationItem" Content="{c:L Ko='사이트 규칙', En='Site rules'}" Tag="rules">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE71C;" />
          </NavigationViewItem.Icon>
          <NavigationViewItem.InfoBadge>
            <InfoBadge x:Name="RulesAttentionBadge" Style="{ThemeResource CautionIconInfoBadgeStyle}" Visibility="Collapsed" />
          </NavigationViewItem.InfoBadge>
        </NavigationViewItem>
        <NavigationViewItem x:Name="HistoryNavigationItem" Content="{c:L Ko='다운로드', En='Downloads'}" Tag="history">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE896;" />
          </NavigationViewItem.Icon>
          <NavigationViewItem.InfoBadge>
            <InfoBadge x:Name="PendingInfoBadge" Visibility="Collapsed" />
          </NavigationViewItem.InfoBadge>
        </NavigationViewItem>
        <NavigationViewItem x:Name="BrowsersNavigationItem" Content="{c:L Ko='브라우저 연결', En='Browsers'}" Tag="browsers">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE774;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="SettingsNavigationItem" Content="{c:L Ko='설정', En='Settings'}" Tag="settings">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="&#xE713;" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>
      <NavigationView.PaneFooter>
        <StackPanel Margin="16,8,16,12" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Grid VerticalAlignment="Center">
              <Ellipse x:Name="ActiveDot" Width="8" Height="8" Fill="{ThemeResource SuccessForegroundBrush}" />
              <Ellipse x:Name="PausedDot" Width="8" Height="8" Fill="{ThemeResource CautionForegroundBrush}" Visibility="Collapsed" />
              <Ellipse x:Name="OfflineDot" Width="8" Height="8" Fill="{ThemeResource CriticalForegroundBrush}" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="RoutingStatusText" Style="{StaticResource CaptionSecondaryTextStyle}" />
          </StackPanel>
          <TextBlock x:Name="VersionText" Style="{StaticResource CaptionSecondaryTextStyle}" />
        </StackPanel>
      </NavigationView.PaneFooter>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar
            x:Name="AgentUnavailableBar"
            Margin="24,16,24,0"
            IsClosable="False"
            IsOpen="False"
            Severity="Error"
            Title="{c:L Ko='백그라운드 서비스에 연결할 수 없습니다', En='Cannot reach the background service'}"
            Message="{c:L Ko='다운로드 분류를 담당하는 Agent가 응답하지 않습니다. 잠시 후 자동으로 다시 연결합니다.', En='The agent that sorts downloads is not responding. The app keeps retrying.'}" />
        <ContentControl
            x:Name="PageHost"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            IsTabStop="False" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
