<Window
    x:Class="DownloadRouter.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource WindowBackgroundBrush}" UseLayoutRounding="True">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WindowWidthStates">
        <VisualState x:Name="Compact">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="ContentViewport.Padding" Value="16,32,16,24" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1200" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="ContentViewport.Padding" Value="32,48,32,32" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <NavigationView
        x:Name="Navigation"
        HorizontalContentAlignment="Stretch"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsPaneToggleButtonVisible="True"
        PaneDisplayMode="Auto"
        SelectionChanged="Navigation_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="대시보드" Tag="dashboard" Icon="Home" />
        <NavigationViewItem Content="사이트 규칙" Tag="rules" Icon="Library" />
        <NavigationViewItem Content="다운로드 이력" Tag="history" Icon="Download" />
        <NavigationViewItem x:Name="PendingNavigationItem" Content="저장 위치 선택 대기" Tag="pending" Icon="Folder">
          <NavigationViewItem.InfoBadge>
            <InfoBadge x:Name="PendingInfoBadge" Visibility="Collapsed" />
          </NavigationViewItem.InfoBadge>
        </NavigationViewItem>
        <NavigationViewItem Content="브라우저 연결" Tag="browsers" Icon="Globe" />
        <NavigationViewItem Content="일반 설정" Tag="settings" Icon="Setting" />
        <NavigationViewItem Content="진단 및 문제 해결" Tag="diagnostics" Icon="Repair" />
        <NavigationViewItem Content="정보" Tag="about" Icon="Help" />
      </NavigationView.MenuItems>
      <ScrollViewer
          x:Name="ContentScrollViewer"
          HorizontalContentAlignment="Stretch"
          HorizontalScrollBarVisibility="Disabled"
          HorizontalScrollMode="Disabled"
          SizeChanged="ContentScrollViewer_SizeChanged"
          VerticalScrollBarVisibility="Auto"
          VerticalScrollMode="Auto">
        <Border
            x:Name="ContentViewport"
            HorizontalAlignment="Stretch"
            Padding="16,32,16,24">
          <StackPanel
              x:Name="ContentPanel"
              MaxWidth="1100"
              HorizontalAlignment="Center"
              Spacing="16" />
        </Border>
      </ScrollViewer>
    </NavigationView>
  </Grid>
</Window>
