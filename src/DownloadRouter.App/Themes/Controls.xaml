<!--
  Shared styles for every window. Colors come only from Palette.xaml tokens via {ThemeResource},
  so a theme switch restyles open windows without rebuilding them. Stock WinUI controls keep
  their Windows 11 templates; only surfaces the platform does not provide are defined here.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DownloadRouter.App.Controls">

  <x:Double x:Key="CardCornerRadiusValue">8</x:Double>
  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <Thickness x:Key="PagePadding">32,28,32,24</Thickness>

  <!-- Typography -->
  <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    <Setter Property="Margin" Value="2,20,0,8" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="CardTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="CaptionSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="StatValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="28" />
  </Style>

  <!-- Surfaces -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Padding" Value="20,16" />
  </Style>
  <Style x:Key="FlatCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style x:Key="SecondaryCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style x:Key="DividerStyle" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{ThemeResource DividerStrokeBrush}" />
  </Style>
  <Style x:Key="WindowRootBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource WindowBackgroundBrush}" />
  </Style>
  <Style x:Key="FooterBarStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource PaneBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="24,12,24,12" />
  </Style>
  <Style x:Key="ShortcutButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Padding" Value="10,4,10,5" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MaxWidth" Value="260" />
  </Style>
  <Style x:Key="PaneStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource PaneBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!-- Status badges (pill) -->
  <Style x:Key="BadgeBaseStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2,8,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="NeutralBadgeStyle" TargetType="Border" BasedOn="{StaticResource BadgeBaseStyle}">
    <Setter Property="Background" Value="{ThemeResource NeutralBadgeBackgroundBrush}" />
  </Style>
  <Style x:Key="AccentBadgeStyle" TargetType="Border" BasedOn="{StaticResource BadgeBaseStyle}">
    <Setter Property="Background" Value="{ThemeResource AccentSubtleBrush}" />
  </Style>
  <Style x:Key="SuccessBadgeStyle" TargetType="Border" BasedOn="{StaticResource BadgeBaseStyle}">
    <Setter Property="Background" Value="{ThemeResource SuccessBackgroundBrush}" />
  </Style>
  <Style x:Key="CautionBadgeStyle" TargetType="Border" BasedOn="{StaticResource BadgeBaseStyle}">
    <Setter Property="Background" Value="{ThemeResource CautionBackgroundBrush}" />
  </Style>
  <Style x:Key="CriticalBadgeStyle" TargetType="Border" BasedOn="{StaticResource BadgeBaseStyle}">
    <Setter Property="Background" Value="{ThemeResource CriticalBackgroundBrush}" />
  </Style>
  <Style x:Key="BadgeTextBaseStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="NeutralBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BadgeTextBaseStyle}">
    <Setter Property="Foreground" Value="{ThemeResource NeutralBadgeForegroundBrush}" />
  </Style>
  <Style x:Key="AccentBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BadgeTextBaseStyle}">
    <Setter Property="Foreground" Value="{ThemeResource AccentTextBrush}" />
  </Style>
  <Style x:Key="SuccessBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BadgeTextBaseStyle}">
    <Setter Property="Foreground" Value="{ThemeResource SuccessForegroundBrush}" />
  </Style>
  <Style x:Key="CautionBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BadgeTextBaseStyle}">
    <Setter Property="Foreground" Value="{ThemeResource CautionForegroundBrush}" />
  </Style>
  <Style x:Key="CriticalBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BadgeTextBaseStyle}">
    <Setter Property="Foreground" Value="{ThemeResource CriticalForegroundBrush}" />
  </Style>

  <!-- Round icon plates used in lists and detail headers -->
  <Style x:Key="IconPlateBaseStyle" TargetType="Border">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="NeutralIconPlateStyle" TargetType="Border" BasedOn="{StaticResource IconPlateBaseStyle}">
    <Setter Property="Background" Value="{ThemeResource NeutralBadgeBackgroundBrush}" />
  </Style>
  <Style x:Key="AccentIconPlateStyle" TargetType="Border" BasedOn="{StaticResource IconPlateBaseStyle}">
    <Setter Property="Background" Value="{ThemeResource AccentSubtleBrush}" />
  </Style>
  <Style x:Key="SuccessIconPlateStyle" TargetType="Border" BasedOn="{StaticResource IconPlateBaseStyle}">
    <Setter Property="Background" Value="{ThemeResource SuccessBackgroundBrush}" />
  </Style>
  <Style x:Key="CautionIconPlateStyle" TargetType="Border" BasedOn="{StaticResource IconPlateBaseStyle}">
    <Setter Property="Background" Value="{ThemeResource CautionBackgroundBrush}" />
  </Style>
  <Style x:Key="CriticalIconPlateStyle" TargetType="Border" BasedOn="{StaticResource IconPlateBaseStyle}">
    <Setter Property="Background" Value="{ThemeResource CriticalBackgroundBrush}" />
  </Style>
  <Style x:Key="IconGlyphBaseStyle" TargetType="FontIcon">
    <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="NeutralIconGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource IconGlyphBaseStyle}">
    <Setter Property="Foreground" Value="{ThemeResource NeutralBadgeForegroundBrush}" />
  </Style>
  <Style x:Key="AccentIconGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource IconGlyphBaseStyle}">
    <Setter Property="Foreground" Value="{ThemeResource AccentTextBrush}" />
  </Style>
  <Style x:Key="SuccessIconGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource IconGlyphBaseStyle}">
    <Setter Property="Foreground" Value="{ThemeResource SuccessForegroundBrush}" />
  </Style>
  <Style x:Key="CautionIconGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource IconGlyphBaseStyle}">
    <Setter Property="Foreground" Value="{ThemeResource CautionForegroundBrush}" />
  </Style>
  <Style x:Key="CriticalIconGlyphStyle" TargetType="FontIcon" BasedOn="{StaticResource IconGlyphBaseStyle}">
    <Setter Property="Foreground" Value="{ThemeResource CriticalForegroundBrush}" />
  </Style>

  <!-- Filter chips: radio buttons drawn as pills; the checked chip uses the subtle accent. -->
  <Style x:Key="ChipRadioButtonStyle" TargetType="RadioButton">
    <Setter Property="Background" Value="{ThemeResource ControlFillBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="12,3,12,5" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid
              x:Name="Root"
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1"
              CornerRadius="14">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Background" Value="{ThemeResource SubtleFillHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Overlay.Background" Value="{ThemeResource SubtleFillPressedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextDisabledBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource AccentSubtleBrush}" />
                    <Setter Target="Root.BorderBrush" Value="{ThemeResource AccentBrush}" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource AccentTextBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Overlay" CornerRadius="13" />
            <ContentPresenter
                x:Name="ContentPresenter"
                Padding="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Destructive primary action (delete, skip all). -->
  <Style x:Key="DangerButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource CriticalFillBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource TextOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,5,16,6" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CriticalFillHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource CriticalFillHoverBrush}" />
                    <Setter Target="ContentPresenter.Opacity" Value="0.8" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Background" Value="{ThemeResource AccentDisabledBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter
                x:Name="ContentPresenter"
                Padding="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text button for destructive actions inside a card (red text, no fill). -->
  <Style x:Key="DangerTextButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Foreground" Value="{ThemeResource CriticalForegroundBrush}" />
  </Style>

  <!-- Windows 11 Settings style row: icon, header and description on the left, a control on the right. -->
  <Style TargetType="controls:SettingsCard">
    <Setter Property="Padding" Value="16,12,16,12" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SettingsCard">
          <Grid
              MinHeight="{TemplateBinding MinHeight}"
              Padding="{TemplateBinding Padding}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="GlyphIcon"
                Width="20"
                VerticalAlignment="Center"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="18"
                Foreground="{ThemeResource TextPrimaryBrush}"
                Glyph="{TemplateBinding Glyph}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock
                  Foreground="{ThemeResource TextPrimaryBrush}"
                  Style="{StaticResource BodyTextBlockStyle}"
                  Text="{TemplateBinding Header}"
                  TextWrapping="Wrap" />
              <TextBlock
                  x:Name="DescriptionText"
                  Style="{StaticResource CaptionSecondaryTextStyle}"
                  Text="{TemplateBinding Description}" />
            </StackPanel>
            <ContentPresenter
                Grid.Column="2"
                MaxWidth="360"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="Center"
                Content="{TemplateBinding Content}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lists: rows keep the Windows 11 selection pill; spacing matches the folder list of the series. -->
  <Style x:Key="AppListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,8,12,8" />
    <Setter Property="Margin" Value="0,1,0,1" />
    <Setter Property="MinHeight" Value="56" />
  </Style>
</ResourceDictionary>
