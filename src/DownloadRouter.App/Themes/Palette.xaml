<!--
  Color tokens shared with the eslee app series 2.0 (eslee Folder Locker v2.0.0 Light.xaml / Dark.xaml).
  Windows and code reference these keys only through {ThemeResource}; no window or code-behind
  file contains a literal color. ThemeService switches Light/Dark by setting RequestedTheme.
  The second block re-points the WinUI brushes that built-in controls use (text, navigation pane)
  at the same tokens so stock Fluent controls and our own surfaces agree.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#EEEEEE" />
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardBackgroundSecondaryBrush" Color="#F9F9F9" />
      <SolidColorBrush x:Key="CardStrokeBrush" Color="#E3E3E3" />
      <SolidColorBrush x:Key="DividerStrokeBrush" Color="#E5E5E5" />

      <SolidColorBrush x:Key="ControlFillBrush" Color="#FDFDFD" />
      <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#F6F6F6" />
      <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#F0F0F0" />
      <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#F7F7F7" />
      <SolidColorBrush x:Key="ControlStrokeBrush" Color="#D6D6D6" />
      <SolidColorBrush x:Key="ControlStrongStrokeBrush" Color="#8A8A8A" />
      <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#0F000000" />
      <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#09000000" />

      <SolidColorBrush x:Key="InputFillBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="InputFillFocusedBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="InputStrokeBrush" Color="#D1D1D1" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C5C5C" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A8A8A" />
      <SolidColorBrush x:Key="TextDisabledBrush" Color="#A3A3A3" />

      <SolidColorBrush x:Key="AccentBrush" Color="#005FB8" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#196EBF" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#3183CA" />
      <SolidColorBrush x:Key="AccentDisabledBrush" Color="#BFBFBF" />
      <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#005FB8" />
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E5EFF9" />

      <SolidColorBrush x:Key="ListItemHoverBrush" Color="#0A000000" />
      <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#E9EFF6" />
      <SolidColorBrush x:Key="ListItemSelectedHoverBrush" Color="#E1E9F3" />

      <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#0F7B0F" />
      <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#DFF6DD" />
      <SolidColorBrush x:Key="CautionForegroundBrush" Color="#9D5D00" />
      <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#FFF4CE" />
      <SolidColorBrush x:Key="CriticalForegroundBrush" Color="#C42B1C" />
      <SolidColorBrush x:Key="CriticalBackgroundBrush" Color="#FDE7E9" />
      <SolidColorBrush x:Key="CriticalFillBrush" Color="#C42B1C" />
      <SolidColorBrush x:Key="CriticalFillHoverBrush" Color="#B02718" />
      <SolidColorBrush x:Key="NeutralBadgeBackgroundBrush" Color="#EBEBEB" />
      <SolidColorBrush x:Key="NeutralBadgeForegroundBrush" Color="#5C5C5C" />

      <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8A8A8A" />
      <SolidColorBrush x:Key="DropOverlayBrush" Color="#CCF3F8FD" />

      <!-- Title bar colors (read by ThemeService; same values as WindowBackgroundBrush / text). -->
      <Color x:Key="TitleBarBackgroundColor">#F3F3F3</Color>
      <Color x:Key="TitleBarForegroundColor">#1B1B1B</Color>
      <Color x:Key="TitleBarButtonHoverColor">#E5E5E5</Color>
      <Color x:Key="TitleBarButtonPressedColor">#D6D6D6</Color>
      <Color x:Key="TitleBarInactiveForegroundColor">#8A8A8A</Color>

      <!-- WinUI brushes re-pointed at the tokens above. -->
      <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1B1B1B" />
      <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5C5C5C" />
      <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8A8A8A" />
      <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#EEEEEE" />
      <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#EEEEEE" />
      <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#EEEEEE" />
      <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#F3F3F3" />
      <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#E3E3E3" />
      <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#E3E3E3" />
      <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#E5E5E5" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
      <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#1B1B1B" />
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
      <SolidColorBrush x:Key="CardBackgroundSecondaryBrush" Color="#262626" />
      <SolidColorBrush x:Key="CardStrokeBrush" Color="#363636" />
      <SolidColorBrush x:Key="DividerStrokeBrush" Color="#333333" />

      <SolidColorBrush x:Key="ControlFillBrush" Color="#2D2D2D" />
      <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#323232" />
      <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#282828" />
      <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="#262626" />
      <SolidColorBrush x:Key="ControlStrokeBrush" Color="#3D3D3D" />
      <SolidColorBrush x:Key="ControlStrongStrokeBrush" Color="#9A9A9A" />
      <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="#0AFFFFFF" />

      <SolidColorBrush x:Key="InputFillBrush" Color="#2D2D2D" />
      <SolidColorBrush x:Key="InputFillFocusedBrush" Color="#1F1F1F" />
      <SolidColorBrush x:Key="InputStrokeBrush" Color="#444444" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C8C8C8" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9B9B9B" />
      <SolidColorBrush x:Key="TextDisabledBrush" Color="#6E6E6E" />

      <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#5ABBEA" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#52A8D4" />
      <SolidColorBrush x:Key="AccentDisabledBrush" Color="#434343" />
      <SolidColorBrush x:Key="TextOnAccentBrush" Color="#000000" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#60CDFF" />
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1F3443" />

      <SolidColorBrush x:Key="ListItemHoverBrush" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#2A3640" />
      <SolidColorBrush x:Key="ListItemSelectedHoverBrush" Color="#303D48" />

      <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#6CCB5F" />
      <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#2A3A23" />
      <SolidColorBrush x:Key="CautionForegroundBrush" Color="#FCE100" />
      <SolidColorBrush x:Key="CautionBackgroundBrush" Color="#433519" />
      <SolidColorBrush x:Key="CriticalForegroundBrush" Color="#FF99A4" />
      <SolidColorBrush x:Key="CriticalBackgroundBrush" Color="#442726" />
      <SolidColorBrush x:Key="CriticalFillBrush" Color="#E2554A" />
      <SolidColorBrush x:Key="CriticalFillHoverBrush" Color="#EC6B61" />
      <SolidColorBrush x:Key="NeutralBadgeBackgroundBrush" Color="#383838" />
      <SolidColorBrush x:Key="NeutralBadgeForegroundBrush" Color="#C8C8C8" />

      <SolidColorBrush x:Key="ScrollThumbBrush" Color="#9B9B9B" />
      <SolidColorBrush x:Key="DropOverlayBrush" Color="#CC1A2733" />

      <Color x:Key="TitleBarBackgroundColor">#202020</Color>
      <Color x:Key="TitleBarForegroundColor">#FFFFFF</Color>
      <Color x:Key="TitleBarButtonHoverColor">#2D2D2D</Color>
      <Color x:Key="TitleBarButtonPressedColor">#383838</Color>
      <Color x:Key="TitleBarInactiveForegroundColor">#9B9B9B</Color>

      <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C8C8C8" />
      <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#9B9B9B" />
      <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#1B1B1B" />
      <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#1B1B1B" />
      <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#1B1B1B" />
      <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#202020" />
      <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#363636" />
      <SolidColorBrush x:Key="ContentDialogBackground" Color="#2B2B2B" />
      <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#2B2B2B" />
      <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#363636" />
      <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#333333" />
    </ResourceDictionary>

    <!-- High contrast: every token follows the user's contrast theme instead of the palette. -->
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="PaneBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="CardBackgroundSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="DividerStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="ControlFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
      <SolidColorBrush x:Key="ControlFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ControlFillPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ControlFillDisabledBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="ControlStrokeBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
      <SolidColorBrush x:Key="ControlStrongStrokeBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
      <SolidColorBrush x:Key="SubtleFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="SubtleFillPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="InputFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="InputFillFocusedBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="InputStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="TextDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="AccentDisabledBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
      <SolidColorBrush x:Key="TextOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="ListItemHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="ListItemSelectedHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="SuccessForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="CautionForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="CautionBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="CriticalForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="CriticalBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="CriticalFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="CriticalFillHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="NeutralBadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="NeutralBadgeForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="ScrollThumbBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="DropOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <Color x:Key="TitleBarBackgroundColor">#000000</Color>
      <Color x:Key="TitleBarForegroundColor">#FFFFFF</Color>
      <Color x:Key="TitleBarButtonHoverColor">#1A1A1A</Color>
      <Color x:Key="TitleBarButtonPressedColor">#333333</Color>
      <Color x:Key="TitleBarInactiveForegroundColor">#C0C0C0</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!--
    Windows default blue, pinned so the app does not change color with the user's accent setting.
    WinUI derives AccentFillColorDefault from Dark1 (light theme, #005FB8) and Light2 (dark theme,
    #60CDFF); hover and pressed are the same color at 90% / 80% opacity, which renders as the
    palette's #196EBF / #3183CA and #5ABBEA / #52A8D4.
  -->
  <Color x:Key="SystemAccentColor">#0078D4</Color>
  <Color x:Key="SystemAccentColorLight1">#0093F9</Color>
  <Color x:Key="SystemAccentColorLight2">#60CDFF</Color>
  <Color x:Key="SystemAccentColorLight3">#99EBFF</Color>
  <Color x:Key="SystemAccentColorDark1">#005FB8</Color>
  <Color x:Key="SystemAccentColorDark2">#004C87</Color>
  <Color x:Key="SystemAccentColorDark3">#003A6B</Color>
</ResourceDictionary>
