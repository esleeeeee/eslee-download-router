{
  "manifest_version": 3,
  "name": "eslee Download Router",
  "description": "사이트 규칙에 따라 완료된 다운로드 파일을 로컬 Windows 앱으로 안전하게 분류합니다.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
