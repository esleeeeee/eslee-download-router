{
  "manifest_version": 3,
  "name": "eslee Download Router",
  "description": "사이트 규칙에 따라 완료된 다운로드 파일을 로컬 Windows 앱으로 안전하게 분류합니다.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "downloads",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
